<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- Logo区域 -->
  <view class="login-header">
    <view class="logo-circle">
      <text class="logo-text">立</text>
    </view>
    <view class="login-title">立和设计</view>
    <view class="login-subtitle">自动化运营管理平台</view>
  </view>

  <!-- 角色选择 -->
  <block wx:if="{{!role}}">
    <view class="role-section">
      <view class="role-card" bindtap="selectRole" data-role="client">
        <view class="role-icon">🏠</view>
        <view class="role-info">
          <view class="role-name">我是客户</view>
          <view class="role-desc">查看项目进度 · 确认节点</view>
        </view>
        <view class="role-arrow">›</view>
      </view>

      <view class="role-card" bindtap="selectRole" data-role="staff">
        <view class="role-icon">📤</view>
        <view class="role-info">
          <view class="role-name">我是员工</view>
          <view class="role-desc">上传成果 · 巡检记录</view>
        </view>
        <view class="role-arrow">›</view>
      </view>

      <view class="role-card" bindtap="selectRole" data-role="boss">
        <view class="role-icon">📊</view>
        <view class="role-info">
          <view class="role-name">我是管理员</view>
          <view class="role-desc">项目总览 · 员工管理</view>
        </view>
        <view class="role-arrow">›</view>
      </view>
    </view>
  </block>

  <!-- 客户登录 -->
  <block wx:if="{{role === 'client'}}">
    <view class="form-section">
      <view class="form-back" bindtap="backToRole">‹ 返回</view>
      <view class="form-title">客户登录</view>
      <view class="form-hint">使用预留的手机号登录查看项目</view>
      <view class="form-field">
        <view class="form-label">手机号</view>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" data-field="phone" bindinput="onInput" value="{{phone}}" />
      </view>
      <button class="form-btn" bindtap="onLogin" disabled="{{loading}}" loading="{{loading}}">登 录</button>
    </view>
  </block>

  <!-- 员工/老板登录 -->
  <block wx:if="{{role === 'staff' || role === 'boss'}}">
    <view class="form-section">
      <view class="form-back" bindtap="backToRole">‹ 返回</view>
      <view class="form-title">{{role === 'boss' ? '管理员登录' : '员工登录'}}</view>
      <view class="form-hint">输入工号和密码登录工作台</view>
      <view class="form-field">
        <view class="form-label">工号</view>
        <input class="form-input" type="text" maxlength="20" placeholder="如 D01 / B01" data-field="staffId" bindinput="onInput" value="{{staffId}}" />
      </view>
      <view class="form-field">
        <view class="form-label">密码</view>
        <input class="form-input" type="text" password="{{true}}" maxlength="20" placeholder="请输入密码" data-field="password" bindinput="onInput" value="{{password}}" />
      </view>
      <button class="form-btn" bindtap="onLogin" disabled="{{loading}}" loading="{{loading}}">登 录</button>
    </view>
  </block>

  <view class="login-footer">立和设计 © 2026</view>
</view>

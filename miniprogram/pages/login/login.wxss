/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #3F5D50 0%, #5A7D6B 40%, #F0F4F2 40%, #F5F6F4 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

.login-header {
  padding: 100rpx 0 60rpx;
  text-align: center;
}
.logo-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.15);
  border: 4rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}
.logo-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}
.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.login-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

/* 角色选择 */
.role-section {
  width: 92%;
  margin-top: 40rpx;
}
.role-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.role-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 72rpx;
  text-align: center;
}
.role-info { flex: 1; }
.role-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E35;
}
.role-desc {
  font-size: 24rpx;
  color: #9AA8A2;
  margin-top: 4rpx;
}
.role-arrow {
  font-size: 40rpx;
  color: #5A7D6B;
}

/* 表单 */
.form-section {
  width: 92%;
  margin-top: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.form-back {
  font-size: 36rpx;
  color: #5A7D6B;
  margin-bottom: 24rpx;
}
.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E35;
}
.form-hint {
  font-size: 24rpx;
  color: #9AA8A2;
  margin: 8rpx 0 40rpx;
}
.form-field {
  margin-bottom: 32rpx;
}
.form-label {
  font-size: 26rpx;
  color: #6B7B73;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-input {
  height: 96rpx;
  background: #F5F6F4;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  border: 2rpx solid #E0E5E2;
}
.form-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #3F5D50 0%, #5A7D6B 100%);
  color: #fff;
  border: none;
  margin-top: 16rpx;
}
.form-btn[disabled] {
  opacity: 0.5;
}

.login-footer {
  text-align: center;
  font-size: 22rpx;
  color: #9AA8A2;
  margin-top: 80rpx;
}

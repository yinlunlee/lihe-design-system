/* pages/client/confirm/confirm.wxss */
.confirm-stage {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E35;
  margin-bottom: 12rpx;
}
.confirm-desc {
  font-size: 28rpx;
  color: #6B7B73;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.confirm-time {
  font-size: 22rpx;
  color: #9AA8A2;
}
.files-tip {
  font-size: 22rpx;
  color: #9AA8A2;
  margin-bottom: 16rpx;
}

/* 操作选择 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.action-card {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  border: 4rpx solid #E0E5E2;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6B7B73;
}
.action-card .action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.action-card.selected.confirm {
  border-color: #4CAF50;
  background: #E8F5E9;
  color: #2E7D32;
}
.action-card.selected.reject {
  border-color: #F44336;
  background: #FFEBEE;
  color: #C62828;
}

/* 反馈 */
.feedback-box {
  margin-top: 24rpx;
}
.feedback-label {
  font-size: 26rpx;
  color: #6B7B73;
  margin-bottom: 12rpx;
}
.req {
  color: #F44336;
}
.feedback-input {
  width: 100%;
  height: 200rpx;
  background: #F5F6F4;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  border: 2rpx solid #E0E5E2;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}

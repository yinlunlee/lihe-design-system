/* pages/boss/projects/projects.wxss */
.filter-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.filter-item {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #6B7B73;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.filter-arrow { color: #9AA8A2; }

.project-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.card-top { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.proj-name { font-size: 30rpx; font-weight: 700; color: #2C3E35; flex: 1; }
.proj-info { display: flex; gap: 24rpx; margin-bottom: 12rpx; }
.proj-info text { font-size: 24rpx; color: #9AA8A2; }
.proj-progress { margin-bottom: 12rpx; }
.proj-stage { font-size: 26rpx; color: #5A7D6B; font-weight: 600; }

.empty { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 60rpx; margin-bottom: 12rpx; }
.loading { text-align: center; padding: 40rpx; color: #9AA8A2; }

/* pages/boss/index/index.wxss */
.page-header { margin-bottom: 32rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #2C3E35; }
.page-sub { font-size: 24rpx; color: #9AA8A2; margin-top: 4rpx; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 24rpx; }
.stat-card { background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.stat-value { font-size: 48rpx; font-weight: 700; color: #5A7D6B; }
.stat-value.warn { color: #FF9800; }
.stat-label { font-size: 24rpx; color: #9AA8A2; margin-top: 8rpx; }

.dist-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.dist-label { font-size: 24rpx; color: #6B7B73; width: 120rpx; }
.dist-bar { flex: 1; height: 16rpx; background: #E0E5E2; border-radius: 8rpx; overflow: hidden; }
.dist-fill { height: 100%; background: #5A7D6B; border-radius: 8rpx; }
.dist-num { font-size: 24rpx; color: #2C3E35; font-weight: 600; width: 40rpx; text-align: right; }

.staff-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #F0F4F2; }
.staff-row:last-child { border-bottom: none; }
.staff-info { display: flex; gap: 16rpx; align-items: center; }
.staff-id { font-size: 28rpx; font-weight: 700; color: #2C3E35; }
.staff-proj { font-size: 24rpx; color: #9AA8A2; }
.staff-prog { display: flex; gap: 16rpx; }
.avg-prog { font-size: 24rpx; color: #5A7D6B; }
.pending { font-size: 22rpx; color: #FF9800; }

.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.quick-card { background: #fff; border-radius: 16rpx; padding: 32rpx 0; text-align: center; font-size: 26rpx; color: #6B7B73; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.quick-icon { font-size: 44rpx; margin-bottom: 8rpx; }

.logout-btn { text-align: center; padding: 24rpx; color: #F44336; font-size: 26rpx; margin-top: 40rpx; }
.loading { text-align: center; padding: 40rpx; color: #9AA8A2; }

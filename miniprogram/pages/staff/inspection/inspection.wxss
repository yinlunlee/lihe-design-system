/* pages/staff/inspection/inspection.wxss */
.proj-name { font-size: 32rpx; font-weight: 700; color: #2C3E35; }
.upload-hint { font-size: 24rpx; color: #9AA8A2; margin-top: 8rpx; }

.field-label { font-size: 28rpx; font-weight: 600; color: #2C3E35; margin-bottom: 8rpx; }
.field-hint { font-size: 22rpx; color: #9AA8A2; margin-bottom: 16rpx; }
.req { color: #F44336; }

.picker-box {
  height: 88rpx;
  background: #F5F6F4;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #E0E5E2;
}
.picker-box.selected { border-color: #5A7D6B; background: #F0F4F2; }
.picker-placeholder { color: #9AA8A2; }
.picker-arrow { color: #9AA8A2; }
.picker-box-input {
  height: 88rpx;
  background: #F5F6F4;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #E0E5E2;
}

.desc-input {
  width: 100%;
  height: 160rpx;
  background: #F5F6F4;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  border: 2rpx solid #E0E5E2;
  box-sizing: border-box;
}

.upload-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 24rpx; }
.upload-btn { display: flex; flex-direction: column; align-items: center; padding: 32rpx 0; background: #F5F6F4; border: 2rpx solid #E0E5E2; border-radius: 16rpx; font-size: 26rpx; color: #6B7B73; }
.upload-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.files-list { margin-top: 16rpx; }

.submit-btn { margin-top: 32rpx; height: 96rpx; line-height: 96rpx; border-radius: 48rpx; font-size: 32rpx; margin-bottom: 40rpx; }

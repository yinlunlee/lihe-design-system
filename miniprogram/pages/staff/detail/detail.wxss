/* pages/staff/detail/detail.wxss */
.proj-name { font-size: 34rpx; font-weight: 700; color: #2C3E35; margin-bottom: 20rpx; }
.proj-meta { margin-bottom: 24rpx; }
.meta-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.meta-label { font-size: 26rpx; color: #9AA8A2; }
.meta-value { font-size: 26rpx; color: #2C3E35; font-weight: 500; }
.proj-progress-box { padding: 20rpx 0; border-top: 2rpx solid #F0F4F2; }
.proj-progress-label { font-size: 24rpx; color: #9AA8A2; margin-bottom: 12rpx; }

.tab-bar { display: flex; margin-bottom: 20rpx; background: #fff; border-radius: 16rpx; padding: 8rpx; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: #9AA8A2; border-radius: 12rpx; }
.tab-item.active { background: #5A7D6B; color: #fff; font-weight: 700; }

.node-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.node-stage { font-size: 30rpx; font-weight: 700; color: #2C3E35; }
.node-desc { font-size: 26rpx; color: #6B7B73; margin-bottom: 12rpx; }
.node-time { font-size: 22rpx; color: #9AA8A2; margin-bottom: 12rpx; }
.node-files { margin-bottom: 12rpx; }
.node-feedback { background: #FFF8E1; padding: 16rpx; border-radius: 12rpx; margin-top: 12rpx; }
.feedback-label { font-size: 24rpx; color: #E65100; font-weight: 600; }

.insp-top { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.insp-stage { font-size: 30rpx; font-weight: 700; color: #2C3E35; }
.insp-date { font-size: 24rpx; color: #9AA8A2; }
.insp-person { font-size: 24rpx; color: #6B7B73; margin-bottom: 8rpx; }
.insp-note { font-size: 26rpx; color: #6B7B73; margin-bottom: 12rpx; }
.insp-issue { background: #FFEBEE; padding: 12rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.issue-label { font-size: 24rpx; color: #C62828; font-weight: 600; }

.empty { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 60rpx; margin-bottom: 12rpx; }

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(135deg, #3F5D50, #5A7D6B);
  color: #fff;
  border-radius: 50%;
  font-size: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(63,93,80,0.4);
  z-index: 100;
}

.video-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 999; }
.loading { text-align: center; padding: 40rpx; color: #9AA8A2; }

/* components/file-item/file-item.wxss */
.file-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F5F6F4;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.file-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  width: 48rpx;
  text-align: center;
}
.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.file-name {
  font-size: 26rpx;
  color: #2C3E35;
  word-break: break-all;
}
.file-meta {
  font-size: 22rpx;
  color: #9AA8A2;
}
.file-remove {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #F44336;
  font-size: 28rpx;
}

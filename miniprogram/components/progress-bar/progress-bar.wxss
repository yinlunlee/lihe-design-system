/* components/progress-bar/progress-bar.wxss */
.progress-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #E0E5E2;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}
.progress-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #3F5D50;
  min-width: 70rpx;
  text-align: right;
}
